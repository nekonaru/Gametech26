    "b10.jejak": [
      { "speaker": "Dimas", "text": "b10.jejak.1" },
      { "speaker": "Dimas", "text": "b10.jejak.2" }
    ],
    "b10.tangan": [
      { "speaker": "Dimas", "text": "b10.tangan.1" },
      { "speaker": "Dimas", "text": "b10.tangan.2" }
    ],
    "b10.baju": [
      { "speaker": "Dimas", "text": "b10.baju.1" },
      { "speaker": "Dimas", "text": "b10.baju.2" }
    ],
    "b10.belum": [
      { "speaker": "Dimas", "text": "b10.belum.1" }
    ],
    "b10.pulang": [
      { "speaker": "Dimas", "text": "b10.pulang.1" },
      { "speaker": "Dimas", "text": "b10.pulang.2" }
    ]
  }
}
