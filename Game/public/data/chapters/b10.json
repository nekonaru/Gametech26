      { "speaker": "Dimas", "text": "b10.rudi.c.3",
        "onExit": [
          { "op": "checkpoint", "id": "b10_jaga" },
          { "op": "loadScene", "scene": "b10alt" }
        ] }
    ],
    "b10.rudi.a": [
      { "speaker": "Rudi", "text": "b10.rudi.a.1" },
      { "speaker": "Dimas", "text": "b10.rudi.a.2" }
    ],
    "b10.rudi.b": [
      { "speaker": "Dimas", "text": "b10.rudi.b.1" },
