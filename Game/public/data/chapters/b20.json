{
  "id": "b20",
  "hari": 7,
  "jam": "21:00",
  "pov": "raka",
  "scene": "hutan_api",
  "onEnter": [
    { "op": "setLighting", "preset": "api", "transition": 2 },
    { "op": "checkpoint", "id": "b20" },
    { "op": "objective", "id": "capai_dimas", "text": "b20.obj.capai_dimas" },
    { "op": "playSound", "key": "ambience_fire", "options": { "category": "ambience", "loop": true, "volume": 0.4 } }
  ],
  "interactables": [
    { "id": "catatan_raka", "prompt": "ui.read", "position": [-1.5, 0, -2], "onUse": [{ "op": "dialog", "node": "b20.catatan" }] },
    { "id": "ponsel_raka", "prompt": "ui.examine", "position": [1.4, 0, -2.4], "onUse": [{ "op": "dialog", "node": "b20.ponsel" }] },
    { "id": "cincin_api", "prompt": "ui.use", "position": [0, 0, -3.5], "onUse": [
      { "op": "dialog", "node": "b20.cincin" },
      { "op": "startPuzzle", "id": "p6", "config": {
        "type": "timing",
        "title": "b20.puzzle.p6.title",
        "description": "b20.puzzle.p6.desc",
        "data": {
          "rings": 3,
          "speeds": [2600, 2000, 1500],
          "hints": ["b20.puzzle.p6.hint1", "b20.puzzle.p6.hint2"]
        },
        "onSolve": [{ "op": "objective", "id": "pilih", "text": "b20.obj.pilih" }],
        "onSkip": [{ "op": "objective", "id": "pilih", "text": "b20.obj.pilih" }],
        "onHelp": [{ "op": "setEcho", "key": "help_p6", "value": true }]
      } }
    ] },
    { "id": "bayangan_joy", "prompt": "ui.examine", "position": [-1.8, 0, -4.5], "onUse": [
      { "op": "if", "condition": "vars.joyDitemui === true",
        "then": [{ "op": "dialog", "node": "b20.joy.kenal" }],
        "else": [{ "op": "dialog", "node": "b20.joy.asing" }] }
    ] },
    { "id": "suara_dimas", "prompt": "ui.talk", "position": [1, 0, -5], "onUse": [
      { "op": "dialog", "node": "b20.dimas" },
      { "op": "objective", "id": "pilih", "text": "b20.obj.pilih" }
    ] },
    { "id": "pilihan_akhir", "prompt": "ui.interact", "position": [0, 0, -5.8], "once": true, "onUse": [
      { "op": "dialog", "node": "b20.pilihan" },
      { "op": "calculateKeyakinan" },
      { "op": "chapterEnd" }
    ] }
  ],
