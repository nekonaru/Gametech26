{
  "id": "b15",
  "hari": 6,
  "jam": "10:00",
  "pov": "raka",
  "scene": "rumah_dimas",
  "onEnter": [
    { "op": "setLighting", "preset": "pagi_desa", "transition": 2 },
    { "op": "objective", "id": "masak", "text": "obj.b15.masak" },
    { "op": "playSound", "key": "ambience_morning", "options": { "category": "ambience", "loop": true, "volume": 0.4 } },
    { "op": "checkpoint", "id": "b15" }
  ],
  "interactables": [
    {
      "id": "lemari_makan",
      "prompt": "ui.examine",
      "position": [-2.5, 1.1, -3.2],
      "once": false,
      "onUse": [ { "op": "dialog", "node": "b15.lemari_makan" } ]
    },
    {
      "id": "catatan_resep",
      "prompt": "ui.read",
      "position": [-2.2, 0.7, -1.4],
      "once": true,
      "onUse": [ { "op": "dialog", "node": "b15.resep" } ]
    },
    {
      "id": "kompor",
      "prompt": "ui.use",
      "position": [0.4, 0.7, -2.8],
      "once": true,
      "onUse": [
        { "op": "dialog", "node": "b15.kompor" },
        { "op": "addEmpati", "value": 1 },
        { "op": "giveItem", "id": "nasi_goreng" },
        { "op": "objective", "id": "temui", "text": "obj.b15.temui" }
      ]
    },
    {
      "id": "meja_makan",
      "prompt": "ui.examine",
      "position": [1.8, 0.8, -2.2],
      "once": false,
      "onUse": [ { "op": "dialog", "node": "b15.meja" } ]
    },
    {
      "id": "jendela_teras",
      "prompt": "ui.examine",
      "position": [3.0, 1.4, -3.6],
      "once": true,
      "onUse": [ { "op": "dialog", "node": "b15.teras" } ]
    },
    {
      "id": "pintu_kamar_dimas",
      "prompt": "ui.interact",
      "position": [0.0, 1.0, -4.8],
      "once": true,
      "onUse": [
        {
          "op": "if",
          "condition": "flags.b14_door_locked === true",
          "then": [ { "op": "dialog", "node": "b15.pintu_terkunci" } ],
          "else": [
            {
              "op": "if",
              "condition": "flags.b14_door_open === true",
              "then": [ { "op": "dialog", "node": "b15.pintu_terbuka" } ],
              "else": [ { "op": "dialog", "node": "b15.pintu_polos" } ]
            }
          ]
        },
        { "op": "dialog", "node": "b15.konfrontasi" }
      ]
    },
    {
      "id": "pintu_depan",
      "prompt": "ui.interact",
      "position": [3.4, 1.0, -4.6],
      "once": true,
      "onUse": [
        { "op": "dialog", "node": "b15.keluar" },
        { "op": "chapterEnd" }
      ]
    }
  ],
  "dialogs": {
